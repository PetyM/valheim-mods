<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <Managed>$(ValheimDir)/valheim_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <Reference Include="$(ValheimDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)/netstandard.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_valheim.dll" Private="false" Publicize="true" />
    <Reference Include="$(Managed)/assembly_utils.dll" Private="false" />
    <Reference Include="$(Managed)/assembly_guiutils.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimDir)/BepInEx/plugins/$(AssemblyName)" />
  </Target>

  <!-- Balíček pro Thunderstore: jen v Release, výstup build/PetyM-<Mód>-<verze>.zip. -->
  <PropertyGroup>
    <ThunderstoreTeam>PetyM</ThunderstoreTeam>
    <ThunderstoreDir>$(MSBuildProjectDirectory)/Thunderstore</ThunderstoreDir>
    <PackageOutDir>$(MSBuildThisFileDirectory)build</PackageOutDir>
  </PropertyGroup>
  <Target Name="Package" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(ThunderstoreDir)/manifest.json')), '(?s).*"version_number"\s*:\s*"([^"]+)".*', '$1'))</ManifestVersion>
      <PluginVersion>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Plugin.cs')), '(?s).*BepInPlugin\([^)]*"([0-9.]+)"\s*\).*', '$1'))</PluginVersion>
      <PackageStage>$(PackageOutDir)/stage/$(AssemblyName)</PackageStage>
      <PackageZip>$(PackageOutDir)/$(ThunderstoreTeam)-$(AssemblyName)-$(ManifestVersion).zip</PackageZip>
    </PropertyGroup>
    <Error Condition="'$(ManifestVersion)' != '$(PluginVersion)'"
           Text="Verze v Thunderstore/manifest.json ($(ManifestVersion)) nesedí s [BepInPlugin] v Plugin.cs ($(PluginVersion))." />
    <ItemGroup>
      <PackageMeta Include="$(ThunderstoreDir)/manifest.json;$(ThunderstoreDir)/icon.png;$(MSBuildProjectDirectory)/README.md;$(MSBuildProjectDirectory)/CHANGELOG.md" />
    </ItemGroup>
    <Error Condition="!Exists('%(PackageMeta.Identity)')" Text="Chybí %(PackageMeta.Identity)." />
    <RemoveDir Directories="$(PackageStage)" />
    <Copy SourceFiles="@(PackageMeta)" DestinationFolder="$(PackageStage)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStage)/plugins" />
    <ZipDirectory SourceDirectory="$(PackageStage)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Balíček: $(PackageZip)" />
  </Target>
</Project>
